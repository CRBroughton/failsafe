{
  "name": "failsafe-monorepo",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nx run-many -t typecheck",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "nx run @crbroughton/failsafe:build && changeset publish"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^3.9.2",
    "@changesets/cli": "^3.0.3",
    "eslint": "^9.17.0",
    "nx": "^20.3.0",
    "typescript": "^5.7.2"
  }
}
