{
  "name": "failsafe-monorepo",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nx run-many -t typecheck",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "release": "nx run-many -t build && changeset publish",
    "deps:check": "taze",
    "deps:update": "taze -w"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@changesets/cli": "catalog:",
    "@crbroughton/eslint-plugin-failsafe": "workspace:*",
    "eslint": "catalog:",
    "nx": "catalog:",
    "taze": "catalog:",
    "typescript": "catalog:"
  }
}
