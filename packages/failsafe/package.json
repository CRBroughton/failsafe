{
  "name": "@crbroughton/failsafe",
  "type": "module",
  "version": "1.1.1",
  "packageManager": "pnpm@9.15.9",
  "description": "Type-safe error handling utilities for TypeScript",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CRBroughton/failsafe.git",
    "directory": "packages/failsafe"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/safe/index.d.mts",
      "import": "./dist/safe/index.mjs"
    },
    "./try": {
      "types": "./dist/try/index.d.mts",
      "import": "./dist/try/index.mjs"
    },
    "./pipe": {
      "types": "./dist/pipe/index.d.mts",
      "import": "./dist/pipe/index.mjs"
    },
    "./gen": {
      "types": "./dist/gen/index.d.mts",
      "import": "./dist/gen/index.mjs"
    }
  },
  "main": "./dist/safe/index.mjs",
  "types": "./dist/safe/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "unbuild",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@crbroughton/eslint-plugin-failsafe": "workspace:*",
    "@crbroughton/ts-test-utils": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "happy-dom": "catalog:",
    "typescript": "catalog:",
    "unbuild": "catalog:",
    "vitest": "catalog:"
  }
}
