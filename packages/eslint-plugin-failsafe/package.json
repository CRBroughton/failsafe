{
  "name": "@crbroughton/eslint-plugin-failsafe",
  "type": "module",
  "version": "0.1.1",
  "description": "ESLint rules enforcing @crbroughton/failsafe usage patterns",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CRBroughton/failsafe.git",
    "directory": "packages/eslint-plugin-failsafe"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@typescript-eslint/utils": "catalog:",
    "eslint-visitor-keys": "catalog:"
  },
  "devDependencies": {
    "@typescript-eslint/rule-tester": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "unbuild": "catalog:",
    "vitest": "catalog:"
  }
}
