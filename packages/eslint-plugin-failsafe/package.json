{
  "name": "@crbroughton/eslint-plugin-failsafe",
  "type": "module",
  "version": "0.1.0",
  "description": "ESLint rules enforcing @crbroughton/failsafe usage patterns",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CRBroughton/failsafe.git",
    "directory": "packages/eslint-plugin-failsafe"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@typescript-eslint/utils": "^8.70.1",
    "eslint-visitor-keys": "^4.2.1"
  },
  "devDependencies": {
    "@typescript-eslint/rule-tester": "^8.70.1",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "unbuild": "^3.0.1",
    "vitest": "^2.1.8"
  }
}
